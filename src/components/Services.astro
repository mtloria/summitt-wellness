---
import { Image } from 'astro:assets';
import ptPhoto from '../assets/hip_flexor_stretch.jpg';
import softTissuePhoto from '../assets/thoracic.jpg';
import dryNeedlePhoto from '../assets/dry_needle-2.jpg';
import { BOOKING_URL } from '../config';

const services = [
  {
    title: 'Physical Therapy',
    photo: ptPhoto,
    photoPosition: 'center 30%',
    alt: 'Ryan Summitt guiding a patient through a half-kneeling hip flexor stretch',
    body: 'A thorough evaluation of how you move, followed by an individualized plan of hands-on treatment and corrective exercise to reduce pain, restore mobility, and rebuild strength.',
    points: ['Movement & strength assessment', 'Corrective exercise', 'Personalized home program'],
  },
  {
    title: 'Soft Tissue Mobilization',
    photo: softTissuePhoto,
    photoPosition: 'center 55%',
    alt: 'Ryan Summitt performing manual therapy on a patient’s upper back',
    body: 'Hands-on manual therapy, including cupping, to release tight, restricted tissue, ease muscle tension, and improve mobility so you can move more freely and get more out of your exercise program.',
    points: ['Muscle tension relief', 'Cupping', 'Joint mobilization'],
  },
  {
    title: 'Dry Needling',
    photo: dryNeedlePhoto,
    photoPosition: 'center 40%',
    alt: 'Ryan Summitt performing dry needling on a patient’s thigh',
    body: 'Thin, sterile needles are used to target trigger points and tight bands of muscle, helping to decrease pain, reduce muscle tension, and restore normal movement.',
    points: ['Trigger point release', 'Pain & tension relief', 'Paired with movement work'],
  },
];
---

<section class="services" id="services">
  <div class="container">
    <div class="services-header">
      <span class="eyebrow">Services</span>
      <h2 class="section-title services-title">
        Hands-On Care.<br />Lasting Results.
      </h2>
      <p class="services-sub">
        Every session is one-on-one with Ryan and built around your goals. Treatment combines the
        services below based on what your body needs.
      </p>
    </div>

    <div class="services-grid">
      {services.map((s) => (
        <article class="service-card">
          <div class="service-photo-wrap">
            <Image
              src={s.photo}
              width={1000}
              widths={[400, 700, 1000]}
              sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 380px"
              alt={s.alt}
              class="service-photo"
              style={`object-position: ${s.photoPosition};`}
              loading="lazy"
            />
          </div>
          <div class="service-info">
            <h3 class="service-title">{s.title}</h3>
            <p class="service-body">{s.body}</p>
            <ul class="service-points">
              {s.points.map((p) => <li>{p}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <div class="services-cta">
      <a href={BOOKING_URL} class="btn btn-gold" target="_blank" rel="noopener">
        Book Now
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9,18 15,12 9,6"></polyline>
        </svg>
      </a>
      <p class="services-note">New patients: select &ldquo;Physical Therapy Evaluation&rdquo; when booking</p>
    </div>
  </div>
</section>

<style>
  .services {
    background-color: var(--c-surface);
    padding: 100px 0;
  }

  .services-header {
    max-width: 600px;
    margin-bottom: 60px;
  }

  .services-title {
    font-size: clamp(2.25rem, 4vw, 3rem);
    margin-bottom: 18px;
  }

  .services-sub {
    font-family: var(--f-body);
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--c-text-muted);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 56px;
  }

  .service-card {
    background: var(--c-bg);
    border: 1px solid var(--c-border);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.22s ease, transform 0.22s ease, border-color 0.22s ease;
  }

  .service-card:hover {
    box-shadow: var(--shadow-md);
    border-color: rgba(192, 139, 62, 0.3);
    transform: translateY(-3px);
  }

  .service-photo-wrap {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--c-border);
  }

  .service-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .service-card:hover .service-photo {
    transform: scale(1.03);
  }

  .service-info {
    padding: 26px 24px 28px;
  }

  .service-title {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--c-primary);
    line-height: 1.1;
    margin-bottom: 12px;
  }

  .service-body {
    font-family: var(--f-body);
    font-size: 0.9375rem;
    line-height: 1.72;
    color: var(--c-text-muted);
    margin-bottom: 18px;
  }

  .service-points {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .service-points li {
    font-family: var(--f-ui);
    font-weight: 500;
    font-size: 0.875rem;
    color: var(--c-primary-light);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .service-points li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-secondary);
    flex-shrink: 0;
  }

  .services-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }

  .services-note {
    font-family: var(--f-body);
    font-size: 0.875rem;
    color: var(--c-text-muted);
  }

  @media (max-width: 900px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .services {
      padding: 72px 0;
    }

    .services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
