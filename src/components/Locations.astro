---
import { BOOKING_URL, LOCATIONS, PHONE_DISPLAY, PHONE_HREF } from '../config';
---

<section class="locations" id="locations">
  <div class="container">
    <div class="locations-header">
      <span class="eyebrow">Locations</span>
      <h2 class="section-title locations-title">
        Two Locations.<br />Serving Zionsville &amp; Carmel.
      </h2>
      <p class="locations-sub">
        See Ryan at whichever location is most convenient for you. Choose your location when you book.
      </p>
    </div>

    <div class="locations-grid">
      {LOCATIONS.map((loc) => (
        <article class="location-card">
          <div class="location-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <h3 class="location-city">{loc.city}</h3>
          <p class="location-host">Located in {loc.host}</p>
          <address class="location-address">
            {loc.street}<br />
            {loc.locality}, {loc.region} {loc.postalCode}
          </address>
          <a href={loc.mapsUrl} class="location-link" target="_blank" rel="noopener">
            Get Directions
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9,18 15,12 9,6"></polyline>
            </svg>
          </a>
        </article>
      ))}
    </div>

    <div class="locations-cta">
      <a href={BOOKING_URL} class="btn btn-gold" target="_blank" rel="noopener">
        Book Now
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9,18 15,12 9,6"></polyline>
        </svg>
      </a>
      <p class="locations-phone">
        Questions? Call <a href={PHONE_HREF}>{PHONE_DISPLAY}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .locations {
    background-color: var(--c-surface);
    padding: 100px 0;
  }

  .locations-header {
    max-width: 600px;
    margin-bottom: 56px;
  }

  .locations-title {
    font-size: clamp(2.25rem, 4vw, 3rem);
    margin-bottom: 18px;
  }

  .locations-sub {
    font-family: var(--f-body);
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--c-text-muted);
  }

  .locations-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-bottom: 56px;
  }

  .location-card {
    background: var(--c-bg);
    border: 1px solid var(--c-border);
    border-radius: 12px;
    padding: 32px 30px;
    transition: box-shadow 0.22s ease, border-color 0.22s ease;
  }

  .location-card:hover {
    box-shadow: var(--shadow-md);
    border-color: rgba(192, 139, 62, 0.3);
  }

  .location-icon {
    color: var(--c-secondary);
    display: flex;
    margin-bottom: 16px;
  }

  .location-city {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 1.75rem;
    color: var(--c-primary);
    line-height: 1.1;
    margin-bottom: 6px;
  }

  .location-host {
    font-family: var(--f-ui);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-secondary-dark);
    margin-bottom: 16px;
  }

  .location-address {
    font-family: var(--f-body);
    font-style: normal;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--c-text-muted);
    margin-bottom: 20px;
  }

  .location-link,
  .locations-phone a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--f-ui);
    font-weight: 600;
    color: var(--c-primary);
    text-decoration: none;
    border-bottom: 2px solid var(--c-secondary);
    padding-bottom: 2px;
    transition: color 0.2s;
  }

  .location-link {
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .location-link:hover,
  .locations-phone a:hover {
    color: var(--c-secondary);
  }

  .locations-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
  }

  .locations-phone {
    font-family: var(--f-body);
    font-size: 0.9375rem;
    color: var(--c-text-muted);
  }

  @media (max-width: 700px) {
    .locations {
      padding: 72px 0;
    }

    .locations-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
