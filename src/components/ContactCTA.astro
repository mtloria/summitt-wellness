---
import mountainImg from '../assets/switzerland_2048x2048.jpg';
import { BOOKING_URL, CONTACT_EMAIL, PHONE_DISPLAY, PHONE_HREF } from '../config';
---

<section
  class="cta"
  id="contact"
  style={`background-image: url('${mountainImg.src}')`}
>
  <div class="cta-overlay"></div>
  <div class="container">
    <div class="cta-inner">
      <span class="eyebrow eyebrow-light">Get Started</span>
      <h2 class="section-title section-title-light cta-title">
        Ready to Feel<br />Your Best?
      </h2>
      <p class="cta-body">
        Book your initial evaluation online and take the first step toward less pain and better
        movement. Have a question first? Ryan is happy to help.
      </p>
      <div class="cta-actions">
        <a href={BOOKING_URL} class="btn btn-gold" target="_blank" rel="noopener">
          Book Now
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9,18 15,12 9,6"></polyline>
          </svg>
        </a>
        <a href={`mailto:${CONTACT_EMAIL}`} class="btn btn-outline-white">
          Email Ryan Directly
        </a>
      </div>
      <p class="cta-note">
        Or call <a href={PHONE_HREF}>{PHONE_DISPLAY}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    padding: 120px 0;
    background-size: cover;
    background-position: center 40%;
    background-repeat: no-repeat;
  }

  .cta-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(15, 26, 39, 0.82) 0%,
      rgba(15, 26, 39, 0.75) 50%,
      rgba(15, 26, 39, 0.88) 100%
    );
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    max-width: 640px;
    text-align: center;
    margin: 0 auto;
  }

  .cta-title {
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    margin-bottom: 22px;
  }

  .cta-body {
    font-family: var(--f-body);
    font-size: 1.0625rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.72);
    margin-bottom: 40px;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-actions {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .cta-note {
    position: relative;
    font-family: var(--f-body);
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .cta-note a {
    color: #ffffff;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 2px solid var(--c-secondary);
  }

  @media (max-width: 600px) {
    .cta {
      padding: 88px 0;
    }

    .cta-actions {
      flex-direction: column;
      align-items: center;
    }

    .cta-actions .btn {
      width: 100%;
      max-width: 320px;
      justify-content: center;
    }
  }
</style>
