---
import { BOOKING_URL } from '../config';

const steps = [
  {
    number: '01',
    title: 'Book Your Initial Evaluation',
    body: 'Schedule online in a few clicks. New patients select “Initial Evaluation.” No physician referral is needed to get started.',
  },
  {
    number: '02',
    title: 'Assessment & Treatment',
    body: "Ryan assesses your movement patterns, mobility, and strength, talks through your goals, and begins treatment that same visit with manual therapy and targeted exercise as needed.",
  },
  {
    number: '03',
    title: 'Your Plan of Care',
    body: "You'll leave with a clear plan and a home exercise program specific to you. Follow-up visits progress your treatment until you're back to doing what you love.",
  },
];
---

<section class="how" id="how-it-works">
  <div class="container">
    <div class="how-inner">
      <div class="how-header">
        <span class="eyebrow eyebrow-light">What to Expect</span>
        <h2 class="section-title section-title-light how-title">
          Simple. Personal.<br />Built Around You.
        </h2>
        <p class="how-sub">
          From your first visit to getting back to full strength &mdash; here&rsquo;s how it works.
        </p>
      </div>

      <div class="steps-grid">
        {steps.map((step, i) => (
          <div class="step-card">
            <div class="step-top">
              <span class="step-number">{step.number}</span>
              {i < steps.length - 1 && (
                <span class="step-connector" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="2">
                    <polyline points="9,18 15,12 9,6"></polyline>
                  </svg>
                </span>
              )}
            </div>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-body">{step.body}</p>
          </div>
        ))}
      </div>

      <div class="how-cta">
        <a href={BOOKING_URL} class="btn btn-gold">
          Book Now
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9,18 15,12 9,6"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .how {
    background-color: var(--c-primary);
    padding: 100px 0;
  }

  .how-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .how-header {
    max-width: 560px;
    margin-bottom: 64px;
  }

  .how-title {
    font-size: clamp(2.25rem, 4vw, 3.125rem);
    margin-bottom: 18px;
  }

  .how-sub {
    font-family: var(--f-body);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.6);
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    width: 100%;
    max-width: 900px;
    margin-bottom: 56px;
    position: relative;
  }

  .step-card {
    padding: 32px 28px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    text-align: left;
    background: rgba(255, 255, 255, 0.04);
    position: relative;
    transition: background 0.2s;
  }

  .step-card:hover {
    background: rgba(255, 255, 255, 0.07);
  }

  .step-top {
    display: flex;
    align-items: center;
    margin-bottom: 20px;
  }

  .step-number {
    font-family: var(--f-display);
    font-weight: 900;
    font-size: 3rem;
    color: var(--c-secondary);
    line-height: 1;
    opacity: 0.85;
  }

  .step-connector {
    margin-left: auto;
    display: none;
  }

  .step-title {
    font-family: var(--f-ui);
    font-weight: 700;
    font-size: 1.125rem;
    color: #ffffff;
    margin-bottom: 12px;
    line-height: 1.3;
  }

  .step-body {
    font-family: var(--f-body);
    font-size: 0.9375rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.62);
  }

  .how-cta {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 760px) {
    .how {
      padding: 72px 0;
    }

    .steps-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
